# ── Base de datos (PostgreSQL) ────────────────────────────────────
# Usuario de la app (operaciones normales: CRUD)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Usuario administrador (backups, mantenimiento, pg_dump)
# Corresponde a admin_panel_user con rol app_db_admin
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRATION_MINUTES=
JWT_REFRESH_EXPIRATION_DAYS=

# ── Backups ───────────────────────────────────────────────────────
# Ruta local temporal donde se genera el .sql antes de subir a Drive
BACKUPS_RUTA_LOCAL=

# ── Google Drive (OAuth2) ─────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=
# Ruta donde se guarda el token tras el primer login (se renueva solo)
GOOGLE_TOKEN_PATH=
# ID de la carpeta de Drive: drive.google.com/drive/folders/ESTE_ID
GOOGLE_DRIVE_FOLDER_ID=

# ── Backup automático semanal ─────────────────────────────────────
BACKUP_DIA_SEMANA=
# Hora en UTC, formato 24h (0 = medianoche)
BACKUP_HORA=

# ── Entorno ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT= 
