# ============================================================
#  FloreriaBautista — Variables de entorno
#  Copia este archivo como .env y llena los valores reales.
#  NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# ── Base de datos (PostgreSQL) ────────────────────────────────────
# Usuario de la app (operaciones normales: CRUD)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=floreria_bautista
DB_USER=app_user
DB_PASSWORD=

# Usuario administrador (backups, mantenimiento, pg_dump)
# Corresponde a admin_panel_user con rol app_db_admin
DB_ADMIN_USER=admin_panel_user
DB_ADMIN_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
JWT_KEY=
JWT_ISSUER=FloreriaBautista
JWT_AUDIENCE=FloreriaBautista
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ── Backups ───────────────────────────────────────────────────────
# Ruta local temporal donde se genera el .sql antes de subir a Drive
# Windows: C:\Backups\FloreriaBautista
# Linux:   /var/backups/floreria_bautista
BACKUPS_RUTA_LOCAL=C:\Backups\FloreriaBautista

# ── Google Drive (OAuth2) ─────────────────────────────────────────
# Ruta al JSON descargado de Google Cloud Console
GOOGLE_CREDENTIALS_PATH=google_credentials.json
# Ruta donde se guarda el token tras el primer login (se renueva solo)
GOOGLE_TOKEN_PATH=google_token.json
# ID de la carpeta de Drive: drive.google.com/drive/folders/ESTE_ID
GOOGLE_DRIVE_FOLDER_ID=

# ── Backup automático semanal ─────────────────────────────────────
# Día: 0=Domingo, 1=Lunes, 2=Martes, 3=Miércoles, 4=Jueves, 5=Viernes, 6=Sábado
BACKUP_DIA_SEMANA=0
# Hora en UTC, formato 24h (0 = medianoche)
BACKUP_HORA=0

# ── Entorno ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
