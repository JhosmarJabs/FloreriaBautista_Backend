<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FloreriaBautista.Tests\**" />
    <EmbeddedResource Remove="FloreriaBautista.Tests\**" />
    <None Remove="FloreriaBautista.Tests\**" />
    <!-- El SDK Web mete todo lo que no sea código como Content y lo copia a la
         salida. Sin este Remove, el bin/ del proyecto de pruebas se copia dentro
         de sí mismo y anida una carpeta más en cada build, hasta que la ruta pasa
         el límite de Windows y la compilación falla con MSB3030. -->
    <Content Remove="FloreriaBautista.Tests\**" />
    <Compile Remove="scratch\**" />
    <EmbeddedResource Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Content Remove="scratch\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Datadog.Trace" Version="3.40.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- snake_case naming: CreadoEn → creado_en automáticamente -->
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="DotNetEnv" Version="3.0.0" />
    <!-- Google Drive SDK -->
    <PackageReference Include="Google.Apis.Drive.v3" Version="1.*" />
    <PackageReference Include="Google.Apis.Auth" Version="1.*" />
    <!-- Cloudinary SDK (subida firmada de respaldos raw) -->
    <PackageReference Include="CloudinaryDotNet" Version="1.*" />
  </ItemGroup>
</Project>
